pipeline {
    agent any
    stages {
        stage ("stage-1") {
            steps {
                echo "This pipeline job number is :1"
                echo "lets execute some linux commands"
            }
        }

        stage ("stage-2") {
            steps {
                echo "This pipeline job number is :2"
                echo "lets execute memory details"
                sh "free -m"
            }
        }

        stage ("stage-3") {
            steps {
                echo "This pipeline job number is :3"
                echo "lrts check hardware details"
                sh "df -h"
            }
        }

        stage ("stage-4") {
            steps {
                echo "This pipeline job number is :4"
                echo "lets check partition details"
                sh "lsblk"
                sh "fdisk -l"
            }
        }
    }

}
